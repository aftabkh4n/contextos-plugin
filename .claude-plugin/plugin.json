  "documentationUrl": "https://github.com/aftabkh4n/contextos#readme",
  "supportUrl": "https://github.com/aftabkh4n/contextos-plugin/issues",
  "privacyPolicyUrl": "https://github.com/aftabkh4n/contextos-plugin/blob/main/PRIVACY.md",
  "keywords": ["memory", "mcp", "context", "decisions", "persistence"],
  "mcpServers": {
    "contextos": {
      "command": "${CLAUDE_PLUGIN_DATA}/bin/0.2.4/contextos",
      "args": ["serve"]
